# Gemini (required for AI generation/chat/evaluation/live audio)
GEMINI_API_KEY=replace_with_new_key
GEMINI_MODEL=gemini-2.5-flash

# SMTP email (optional until configured; example shown for Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-sender@gmail.com

# Google Calendar + Google Meet (OAuth client JSON downloaded separately)
GOOGLE_OAUTH_CLIENT_FILE=credentials.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback
TIMEZONE=Asia/Kolkata

# Frontend origins, comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
